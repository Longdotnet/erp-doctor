{
  "sqlServer": {
    "connectionString": "${ERP_DB}",
    "databaseSizeWarningGb": 20,
    "logSizeWarningGb": 5,
    "blockingWarningSeconds": 10,
    "longRunningWarningSeconds": 30,
    "largestTablesLimit": 10,
    "growthTablesLimit": 50
  },
  "http": {
    "endpoints": [
      {
        "name": "ERP API",
        "url": "https://localhost:5001/health",
        "expectedStatusCode": 200,
        "timeoutSeconds": 10,
        "latencyWarningMs": 1500
      }
    ]
  },
  "iis": {
    "appPools": [
      "ErpApi"
    ],
    "sites": [
      {
        "name": "ERP Site",
        "expectedBindings": [
          "https:*:443:erp.example.com"
        ],
        "checkPhysicalPath": true
      }
    ]
  },
  "windowsEventLog": {
    "queries": [
      {
        "name": "ERP application errors",
        "logName": "Application",
        "lookbackMinutes": 60,
        "maxEvents": 20,
        "includeWarnings": false,
        "providers": [
          ".NET Runtime",
          "Application Error",
          "IIS AspNetCore Module V2"
        ]
      }
    ]
  },
  "plugins": {
    "assemblies": [],
    "settings": {}
  },
  "system": {
    "diskWarningFreePercent": 15,
    "diskCriticalFreePercent": 5,
    "memoryWarningAvailablePercent": 15
  }
}
